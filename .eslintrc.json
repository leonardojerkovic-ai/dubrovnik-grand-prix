{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "eqeqeq": [
      "warn",
      "smart"
    ],
    "prefer-const": "warn",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/text-\\[\\d+px\\]/]",
        "message": "Najmanja velicina teksta je text-xs (12 px) - ne koristi text-[10px] ni text-[11px]."
      },
      {
        "selector": "TemplateElement[value.raw=/text-\\[\\d+px\\]/]",
        "message": "Najmanja velicina teksta je text-xs (12 px) - ne koristi text-[10px] ni text-[11px]."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "scripts/**/*.ts",
        "lib/fide/**/*.ts",
        "lib/email.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "prisma/migrations/"
  ]
}

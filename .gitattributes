# Datoteke koje se nikada ne smiju dirati pri checkoutu.
#
# Bez ovoga git prepoznaje vrstu datoteke heuristikom, a PDF koji sadrži
# ASCII85 kodirane slike gotovo je cijeli ispisiv tekst — git ga tada svrsta
# u tekstualne i na Windowsu mu pri checkoutu mijenja prijelome redaka
# (core.autocrlf). Takav PDF se više ne otvara.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.woff  binary
*.woff2 binary

# Izvorni kod uvijek s LF u repozitoriju, bez obzira na platformu.
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.prisma text eol=lf

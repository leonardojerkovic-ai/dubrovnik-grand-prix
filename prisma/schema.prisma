// ============================================================================
// Dubrovnik Grand Prix — Prisma shema
// Provider: PostgreSQL (Supabase)
// ============================================================================
//
// Supabase zahtijeva DVA connection stringa:
//   DATABASE_URL — pooled konekcija preko PgBouncera (port 6543), koristi je
//                  aplikacija u produkciji (Vercel serverless funkcije)
//   DIRECT_URL   — direktna konekcija (port 5432), koristi je Prisma ISKLJUČIVO
//                  za migracije (`prisma migrate`), jer PgBouncer u transaction
//                  modu ne podržava neke DDL naredbe
//
// Oba stringa se nalaze u Supabase dashboardu: Project Settings -> Database
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// ENUMI
// ----------------------------------------------------------------------------

enum Role {
  PLAYER
  ADMIN
  GP_MANAGER // voditelj GP-a / voditelj natjecanja Akademije (čl. 26 / čl. 21)
}

enum Title {
  GM
  IM
  FM
  CM
  WGM
  WIM
  WFM
  WCM
  MK // majstorski kandidat
  I
  II
  III
  IV
  V
  NONE
}

enum Gender {
  M
  F
}

enum SystemType {
  GP        // Dubrovnik Grand Prix (glavni sustav)
  AKADEMIJA // Grand Prix Akademije (odvojen sustav, čl. 2 GP Akademije)
}

enum TournamentLevel {
  KLUPSKA        // FC = 1.00
  NATJECATELJSKA // FC = 1.25
  VRHUNSKA       // FC = 1.50
}

enum Tempo {
  STANDARD // FT = 1.00
  RAPID    // FT = 0.90
  BLITZ    // FT = 0.75
}

enum RatingType {
  STANDARD
  RAPID
  BLITZ
}

enum TournamentFormat {
  SWISS
  ROUND_ROBIN
}

enum TournamentStatus {
  NAJAVA
  PRIJAVE_OTVORENE
  U_TIJEKU
  ZAVRSEN
}

enum RegistrationStatus {
  PRIJAVLJEN
  OTKAZAN
  NA_CEKANJU
}

enum DocumentCategory {
  PRAVILNIK
  ZAPISNIK
  OSTALO
}

// ----------------------------------------------------------------------------
// KORISNICI I IGRAČI
// ----------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role     @default(PLAYER)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player Player? // 1:1 — vlastiti igrački profil vlasnika računa
  /// Djeca kojima ovaj račun upravlja. Roditelj s troje djece ne treba tri
  /// adrese e-pošte; vlastiti profil (player) i skrbništvo su odvojeni, pa
  /// roditelj može i sam igrati, i ne mora.
  guardianOf GuardianLink[]
  passwordResetTokens PasswordResetToken[]
  gdprConsentAt DateTime? // vremenski žig privole s Politikom privatnosti pri registraciji — dokaz privole

  /// Zahtjev za povezivanje s postojećim igračkim profilom, na čekanju.
  ///
  /// Samostalna registracija NIKAD ne spaja račun s postojećim profilom
  /// automatski: ime, prezime i godište javno su dostupni na FIDE stranicama,
  /// pa bi bilo tko mogao preuzeti tuđi profil, a s njim prijave i rezultate.
  /// Umjesto toga se bilježi zahtjev, a povezuje ga administrator.
  needsPlayerLink  Boolean @default(false)
  /// Profil za koji sustav pretpostavlja da je traženi (jedno podudaranje).
  /// Prazno kad podudaranja nema ili ih je više — admin tada bira sam.
  pendingPlayerId  String?
  /// Ime i godište kako ih je osoba upisala — podloga adminu za odluku.
  claimedName      String?
  claimedBirthYear Int?

  @@index([needsPlayerLink])
  @@map("users")
}

/// Token za reset lozinke — jednokratan, s rokom trajanja.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hash tokena, nikad sam token. Poveznica koja stiže emailom
  /// sadrži izvorni token; u bazi stoji samo njegov otisak, pa procurjeli
  /// redak ne omogućuje preuzimanje računa.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Player {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  fideId        String?  @unique
  title         Title    @default(NONE)
  gender        Gender
  birthYear     Int       // godište — koristi se za GP dobne kategorije (U12/U16/U20), čl. 22 GP: "prema godištu"
  /// TRENUTNO stanje članstva. Za ljestvice se NE koristi — čl. 4 traži
  /// članstvo na dan početka turnira, pa se ono zapisuje po rezultatu
  /// (TournamentResult.wasClubMember). Ovo polje služi za prikaz profila i
  /// za pravo nastupa na završnim turnirima (čl. 11 Akademije).
  isClubMember  Boolean  @default(false)
  memberSince   DateTime?
  /// Datum prestanka članstva. Prazno = i dalje član. Bez ovoga se izlazak
  /// iz kluba ne može zabilježiti, pa bi bivši član trajno ostajao "član"
  /// za sve buduće turnire.
  memberUntil   DateTime?

  /// Igrač je preminuo. Uklanja ga s popisa igrača i iz odabira za buduće
  /// turnire, ali NE dira njegove rezultate, ljestvice na kojima se već
  /// nalazi ni Hall of Fame — to je dio povijesti kluba i ostaje.
  /// Razlikuje se od memberUntil, koji označava odlazak iz kluba.
  /// Otisak pristupnog koda kojim igrač sam poveže svoj račun s ovim
  /// profilom. Sam kod se NE sprema — prikazuje se jednom, pri generiranju.
  /// Vidi lib/link-code.ts.
  linkCodeHash    String?   @unique
  linkCodeIssuedAt DateTime?
  /// Kad je kod iskorišten. Popunjeno = kod više ne vrijedi.
  linkCodeUsedAt  DateTime?

  deceased      Boolean  @default(false)
  /// Godina smrti, ako je poznata. Na profilu se prikazuje uz godište.
  deceasedYear  Int?
  photoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ratingsCurrent   PlayerRatingCurrent?
  ratingsHistory   PlayerRatingSnapshot[]
  results          TournamentResult[]
  registrations    TournamentRegistration[]
  hallOfFameEntries HallOfFame[]
  academyEligibility AcademyEligibility[]
  guardians          GuardianLink[]

  @@index([lastName, firstName])
  @@map("players")
}

/// Trenutni (najnoviji) rejting — brzi lookup za profil igrača, javne stranice.
/// Ažurira se ručno svakog 1. u mjesecu; svaki update ISTOVREMENO kreira
/// zapis u PlayerRatingSnapshot (povijest se nikad ne briše/prepisuje).
model PlayerRatingCurrent {
  playerId String @id
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  standard Int?
  rapid    Int?
  blitz    Int?

  updatedAt DateTime @updatedAt

  @@map("player_ratings_current")
}

/// Povijesni snapshot rejtinga na određeni datum (mjesečni unos admina).
/// Za izračun FR (čl. 7 GP pravilnika) uzima se snapshot s najvećim
/// snapshotDate <= datum turnira, za odgovarajući ratingType (tempo turnira).
model PlayerRatingSnapshot {
  id           String     @id @default(cuid())
  playerId     String
  /// Restrict, a NE Cascade: rezultat je povijesni podatak turnira, ne
  /// igrača. Brisanjem igrača nestao bi njegov redak, ali on je bio dio
  /// broja igrača (N) iz kojega su računati bodovi SVIMA ostalima i
  /// njegovo mjesto određivalo je njihove plasmane. U bazi bi ostao turnir
  /// s rupom u poretku i bodovima koji se više ne mogu provjeriti.
  /// Igrača koji je nastupao ne briše se — vidi polje `deceased` i
  /// `memberUntil` za način da nestane s popisa uz zadržanu povijest.
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  ratingType   RatingType
  ratingValue  Int
  snapshotDate DateTime // datum na koji je vrijednost bila važeća (npr. 1. u mjesecu)
  createdAt    DateTime   @default(now())

  /// Jedan zapis po igraču, tempu i danu — uvoz mora biti ponovljiv bez
  /// stvaranja duplikata. Datum se normalizira na ponoć.
  @@unique([playerId, ratingType, snapshotDate])
  @@index([playerId, ratingType, snapshotDate])
  @@map("player_rating_snapshots")
}

// ----------------------------------------------------------------------------
// SEZONE, TURNIRI, REZULTATI
// ----------------------------------------------------------------------------

model Season {
  id         String     @id @default(cuid())
  system     SystemType
  yearLabel  String     // npr. "2027" (GP) ili "2026/27" (Akademija)
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  /// Verzija pravilnika po kojoj se boduje ova sezona, npr. "GP-2.2" ili
  /// "AKD-1.1". Odvojena numeracija po sustavu — vidi lib/scoring/rulebook.ts.
  /// Kopira se u svaki scoringSnapshot da se vidi po kojoj je verziji
  /// rezultat nastao i ako se sezoni kasnije promijeni oznaka (čl. 30 GP).
  rulebookVersion String?

  tournaments    Tournament[]
  academyEligibility AcademyEligibility[]
  hallOfFame     HallOfFame[]
  announcements  Announcement[]
  documents      Document[]

  @@unique([system, yearLabel])
  @@map("seasons")
}

model Tournament {
  id       String @id @default(cuid())
  seasonId String
  // Restrict: ne dopušta brisanje sezone dok god ima turnira (zaštita od
  // slučajnog masovnog brisanja) — admin mora prvo obrisati turnire pojedinačno.
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  name   String
  date   DateTime
  format TournamentFormat
  rounds Int

  // Polja specifična za GP (null za Akademiju):
  level TournamentLevel?

  tempo Tempo

  // Stvarni tempo igre za prikaz (npr. "10 min + 5 sek po potezu") — Tempo
  // enum gore ostaje za FT faktor u bodovnom izračunu (čl. 8 GP), ova dva
  // polja su samo informativna za korisnike.
  baseMinutes      Int?
  incrementSeconds Int?

  /// Mjesto održavanja, npr. "Dom šaha, Liechtensteinov put 12, Dubrovnik".
  venue String?

  /// Vrijeme početka u obliku "HH:MM". Namjerno tekst, a ne datum s
  /// vremenom: `date` se koristi kao dan na više mjesta (usporedbe članstva,
  /// cjelodnevni događaji u kalendaru), pa bi mu dodavanje sata unijelo
  /// vremenske zone ondje gdje ih nema.
  startTime String?

  /// Poveznica na raspis turnira (PDF ili stranica).
  announcementUrl String?

  isFinal       Boolean @default(false) // GP Finale / Prvenstvo Akademije
  isJuniorFinal Boolean @default(false) // Juniorsko GP Finale (samo GP sustav)

  // Ograničenje prava nastupa (čl. 14 GP): npr. ["U16"], ["ZENE"], null = otvoren svima
  restrictedCategories Json?

  status TournamentStatus @default(NAJAVA)

  minPlayersMet Boolean @default(false) // izračunato nakon unosa rezultata (N>=6 za GP / N>=7 za Akademiju + odigran predviđen broj kola)

  /// Akademija: vrijedi li uvjet iz čl. 3 (godište i rapid rejting) i za
  /// PRAVO NASTUPA, ne samo za pravo na bodove. Čl. 6 nastup prepušta
  /// raspisu, pa je to postavka po turniru, a ne pravilo pravilnika.
  /// Zadano uključeno — to je ono što klub gotovo uvijek želi.
  academyPointsOnly Boolean @default(true)

  /// Trenutak prve objave rezultata. Od njega teče rok od 7 dana za prigovor
  /// (čl. 29 GP / čl. 22 Akademije); nakon isteka rezultati su konačni.
  /// Zaključavanje se ne sprema kao zastavica nego izvodi iz ovog datuma —
  /// zastavica bi se mogla razići sa stvarnim protekom vremena.
  resultsPublishedAt DateTime?

  /// Privremeno otključavanje već konačnih rezultata. Postavlja ga admin uz
  /// obrazloženje; zapisuje se u audit log. Vidi lib/scoring/results-lock.ts.
  unlockedUntil  DateTime?
  unlockReason   String?
  unlockedByEmail String?

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?

  createdAt DateTime @default(now())

  @@index([seasonId])
  updatedAt DateTime @updatedAt

  results       TournamentResult[]
  registrations TournamentRegistration[]
  announcements Announcement[]
  academyEligibilityFirst AcademyEligibility[]

  @@index([seasonId, date])
  @@map("tournaments")
}

model TournamentResult {
  id           String @id @default(cuid())
  tournamentId String
  // Cascade: rezultat bez turnira nema smisla — brisanjem turnira brišu se i njegovi rezultati.
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     String
  // Cascade: brisanje igrača (rijetka, svjesna admin radnja) briše i njegove rezultate.
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  rank        Int     // R — konačni plasman
  gamesPlayed Boolean @default(true) // false = igrač nije odigrao nijednu partiju -> ne ulazi u N

  /// Je li igrač bio član ŠK Dubrovnik NA DAN TURNIRA — čl. 4. Zapisuje se
  /// pri spremanju rezultata i poslije se ne mijenja. Ljestvice filtriraju
  /// po ovome, a ne po Player.isClubMember: naknadno učlanjenje ne smije
  /// retroaktivno uvrstiti igrača na već odigrane turnire.
  wasClubMember Boolean @default(false)

  // Rejting korišten za FR izračun (GP) — automatski popunjen iz najbližeg
  // PlayerRatingSnapshot prije/na datum turnira, admin može override-ati ručno.
  ratingSnapshotUsed Int?
  ratingOverridden   Boolean @default(false)

  gpPoints Int? // izračunati GP bodovi za ovaj rezultat (spremljeno radi audit traga)

  /// Kako su bodovi nastali: svi faktori, N, R, omjer i verzija pravilnika.
  /// Oblik se razlikuje po sustavu (GP ima FR/FC/FT, Akademija nema) — vidi
  /// ScoringSnapshot u lib/scoring/rulebook.ts. Bez ovoga se izmjena
  /// pravilnika ne može razlikovati od ispravka pogreške (čl. 30 GP / čl. 23
  /// Akademije) niti se prigovor po čl. 29 može provjeriti.
  scoringSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, playerId])
  /// Plasman je jedinstven unutar turnira (čl. 10 Akademije). Zaštita na
  /// razini baze, uz provjeru pri unosu — dvostruki plasman tiho iskrivi
  /// cijelu ljestvicu i teško se otkriva naknadno.
  @@unique([tournamentId, rank])
  @@index([playerId])
  @@map("tournament_results")
}

model TournamentRegistration {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  status       RegistrationStatus @default(PRIJAVLJEN)
  registeredAt DateTime            @default(now())

  @@unique([tournamentId, playerId])
  @@index([playerId])
  @@map("tournament_registrations")
}

// ----------------------------------------------------------------------------
// KATEGORIJE
// ----------------------------------------------------------------------------

// Popis ljestvica živi u kodu (lib/scoring/gp/categories.ts i
// lib/standings/*), ne u bazi — kategorije su fiksne i propisane
// pravilnikom, pa referentna tablica ne bi ništa dodala.
//
// Nekadašnja tablica PlayerCategoryMembership uklonjena je jer nije bila
// potrebna: dobne i veteranske kategorije ovise samo o godištu igrača i
// godini početka sezone, a oboje je nepromjenjivo tijekom sezone. Rejtinška
// kategorija (U1800) ovisi o rejtingu zabilježenom uz rezultat turnira
// (TournamentResult.ratingSnapshotUsed). Ni u jednom slučaju nema
// retroaktivnosti koju bi zaseban snapshot spriječio.

/// Zaključano pravo na bodove u GP-u Akademije — čl. 3.
///
/// Pravo se utvrđuje NA DAN PRVOG NASTUPA igrača u sezoni (dob ispod 14 na
/// 1. siječnja godine u kojoj sezona počinje + rapid rejting ispod 1600 ili
/// bez rejtinga) i vrijedi cijelu sezonu. Ako bi se računalo uživo, igrač
/// koji tijekom sezone prijeđe 1600 retroaktivno bi izgubio već osvojene
/// bodove, što pravilnik ne predviđa.
model AcademyEligibility {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  isEligible Boolean

  /// Turnir na kojemu je pravo zaključano — prvi nastup igrača u sezoni.
  /// Ako se naknadno unese raniji turnir, zapis se preračunava prema njemu.
  firstTournamentId   String?
  firstTournament     Tournament? @relation(fields: [firstTournamentId], references: [id], onDelete: SetNull)
  firstTournamentDate DateTime

  /// Vrijednosti na kojima se odluka temeljila — radi provjere prigovora.
  rapidRatingAtFirst Int?
  birthYearUsed      Int?

  lockedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, playerId])
  @@index([playerId])
  @@index([firstTournamentId])
  @@map("academy_eligibility")
}

/// Skrbništvo nad maloljetnim igračem.
///
/// Postoji zato što jedan roditelj često vodi dvoje ili troje djece, a
/// tražiti tri odvojene adrese e-pošte bilo bi besmisleno. Odvojeno je od
/// User.player, koji je vlastiti profil vlasnika računa — roditelj može
/// imati i jedno i drugo, ili samo skrbništvo.
///
/// Uspostavlja se samo za igrače mlađe od 18 godina. Kad dijete postane
/// punoljetno, veza NE prestaje sama od sebe — prekid usred sezone zatekao
/// bi ga bez pristupa. Umjesto toga se pojavljuje na popisu u adminu, gdje
/// se razrješava od slučaja do slučaja.
model GuardianLink {
  id              String   @id @default(cuid())
  guardianUserId  String
  guardian        User     @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([guardianUserId, playerId])
  @@index([playerId])
  @@map("guardian_links")
}

/// Trag o izmjenama u adminu.
///
/// Čl. 29 daje igraču pravo prigovora na izračun u roku od 7 dana. Bez
/// zapisa tko je, kada i što promijenio, prigovor se svodi na sjećanje.
/// Zapisi se samo dodaju — nikad se ne mijenjaju ni brišu iz aplikacije.
model AuditLog {
  id String @id @default(cuid())
  at DateTime @default(now())

  /// Tko je izveo radnju. Email umjesto veze na User jer trag mora ostati
  /// čitljiv i nakon što se korisnički račun obriše.
  actorEmail String
  actorRole  String

  action   String  // CREATE | UPDATE | DELETE | RECALCULATE
  entity   String  // Player, Tournament, Season, TournamentResult, ...
  entityId String?

  /// Ljudski čitljiv opis na hrvatskom — ono što se vidi u pregledu.
  summary String

  /// Stanje prije i poslije, gdje ima smisla. Kod brisanja se puni samo
  /// "before", jer je to jedini preostali zapis o obrisanom podatku.
  before Json?
  after  Json?

  @@index([at])
  @@index([entity, entityId])
  @@index([actorEmail])
  @@map("audit_log")
}

// ----------------------------------------------------------------------------
// SADRŽAJ: DOKUMENTI, NAJAVE, HALL OF FAME
// ----------------------------------------------------------------------------

model Document {
  id       String           @id @default(cuid())
  title    String
  fileUrl  String
  category DocumentCategory
  seasonId String?
  // SetNull: brisanje sezone ne briše dokumente, samo im ukloni poveznicu na sezonu.
  season   Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("documents")
}

model Announcement {
  id           String      @id @default(cuid())
  title        String
  body         String      @db.Text
  publishedAt  DateTime    @default(now())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  seasonId     String?
  season       Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([seasonId])
  @@map("announcements")
}

model HallOfFame {
  id           String   @id @default(cuid())
  seasonId     String
  // Restrict: povijesni zapisi pobjednika se ne smiju izgubiti slučajnim brisanjem sezone.
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  categoryCode String
  playerId     String
  // Restrict: ne dopušta brisanje igrača koji ima Hall of Fame zapis bez svjesne odluke.
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  place        Int      // 1, 2, 3
  pointsTotal  Int

  @@unique([seasonId, categoryCode, place])
  @@index([playerId])
  @@map("hall_of_fame")
}

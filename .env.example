# Supabase Postgres — Project Settings -> Database u Supabase dashboardu
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generiraj s: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> OAuth 2.0 Client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub Actions (uvoz FIDE rejtinga) — postavi kao Secret u repozitoriju,
# Settings -> Secrets and variables -> Actions. Koristi session pooler URL.
